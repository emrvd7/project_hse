list_numbers15_31 = list(range(15, 32))
dates = []
for el2 in list_numbers15_31:
    dates.append(f'2026-05-{el2}')










#this function extracts main information about film
def extractor_to_list_of_dict(html_info_about_onefilm_in_one_cinema, time_of_show):
     l = []
     one_film_raw = html_info_about_onefilm_in_one_cinema

     #print(one_film_raw.select('.title'))
     #print(one_film_raw.select_one('.title').get_text(' ').strip())
     #text = one_film_raw.select_one('.title').get_text(' ').strip()
     
     title_div = one_film_raw.select_one(".title")
     name = title_div.contents[0].strip()
     meta = title_div.select_one("small").get_text(strip=True)
     year, length, country, age = [x.strip() for x in meta.split("/")]
     length = length.replace("мин", "").strip()
     
     

     for i in range(len(one_film_raw.select('.time'))):
         one_film_data = {}
         one_film_data['name'] = name
         one_film_data['date'] = time_of_show
         one_film_data['year_of_production']= year
         one_film_data['length_min'] = length
         try :
             one_film_data['length_min'] = int(one_film_data['length_min'])

         except ValueError:
             pass
         one_film_data['age_restriction'] = age
         one_film_data['country'] = country
         one_film_data['time'] = one_film_raw.select('.time')[i].get_text()
         one_film_data['price'] = one_film_raw.select('.price')[i].get_text().replace(' P', '')
         try :
             one_film_data['price'] = int(one_film_data['price'])

         except ValueError:
             pass
         l.append(one_film_data)

     return l







films_info_schedule = []



#here we apply the previous function to the timetable of films 15th-31th of May
driver = webdriver.Chrome()
print(dates)
for date_el in dates:
    
    driver.get(f'https://mos-kino.ru/schedule/?date={date_el}')
    WebDriverWait(driver, 10).until(

    EC.presence_of_all_elements_located((By.CSS_SELECTOR, ".schedule-item"))

)


    raw_schedule = driver.page_source
    soup_schedule= BeautifulSoup(raw_schedule, "html.parser")
    list_of_content_in_cinemas = list(soup_schedule.select('.content'))
    
    
    


    for i in range(len(list_of_content_in_cinemas)):
         
         for j in range(len(soup_schedule.select('.content')[i].select('.schedule-item'))):
             one_film_data = extractor_to_list_of_dict(soup_schedule.select('.content')[i].select('.schedule-item')[j], date_el)

             films_info_schedule += one_film_data

print(films_info_schedule)
driver.quit()



df111 = pd.DataFrame(films_info_schedule)
df111.to_csv('/Users/egormorozov/Desktop/movies.csv', index=False)

             
             
         
    
    
    


    




