class column_cleaner:
    def __init__(self, df, col_name):
        self.df = df
        self.col = col_name

    def float_er(self):
        self.df[self.col] = pd.to_numeric(self.df[self.col], errors="coerce")
        return self


    def fillna_er(self, value):
        self.df[self.col] = self.df[self.col].fillna(value)
        return self
    
class df_wrapper:
    def __init__(self, df):
        self.df = df

    def col_er(self, col_name):
        return column_cleaner(self.df, col_name)
    
