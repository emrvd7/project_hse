def haversine_formula(lat_metro, lon_metro, lat_moscow=55.7558, lon_moscow=37.6173):
    R = 6371 

    lat_metro, lon_metro, lat_moscow, lon_moscow = map(np.radians, [lat_metro, lon_metro, lat_moscow, lon_moscow])

    delta_lat = lat_moscow - lat_metro
    delta_lon = lon_moscow - lon_metro

    a = np.sin(delta_lat/2)**2 + np.cos(lat_metro)*np.cos(lat_moscow)*np.sin(delta_lon/2)**2
    c = 2 * np.arctan2(np.sqrt(a), np.sqrt(1 - a))

    return R * c


